chart
title: Server Performance Metrics - Multi-Scale Compact Format
xaxis: date

scale
  id: response-time
  label: Response Time (ms)
  type: number

scale
  id: requests
  label: Request Count
  type: number

scale
  id: cpu
  label: CPU Usage (%)
  type: number
  min: 0
  max: 100

series: API Response | DB Query | Cache Lookup
yaxis: response-time | response-time | response-time
color: #3b82f6 | #ef4444 | #10b981
style: line | dashed | dotted
data:
  2025-01-01: 120 | 85 | 15
  2025-01-02: 135 | 92 | 18
  2025-01-03: 110 | 78 | 12
  2025-01-04: 125 | 88 | 16
  2025-01-05: 140 | 95 | 20

series: Total Requests | Failed Requests
